#!/usr/bin/env bash

# Commit message hook for k8s-agent project
# Based on OneX project standards and Conventional Commits

set -e

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Skip for merge commits
if echo "$COMMIT_MSG" | grep -q "^Merge"; then
    exit 0
fi

# Skip for revert commits
if echo "$COMMIT_MSG" | grep -q "^Revert"; then
    exit 0
fi

# Conventional Commits pattern
# Format: <type>(<scope>): <subject>
#
# Types: feat, fix, docs, style, refactor, perf, test, chore, build, ci
# Scope: optional, e.g., agent-manager, orchestrator, reasoning
# Subject: brief description in imperative mood

PATTERN="^(feat|fix|docs|style|refactor|perf|test|chore|build|ci)(\([a-z0-9-]+\))?: .{1,100}$"

if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
    echo -e "${RED}Invalid commit message format!${NC}"
    echo ""
    echo -e "${YELLOW}Commit message should follow Conventional Commits format:${NC}"
    echo ""
    echo "  <type>(<scope>): <subject>"
    echo ""
    echo -e "${YELLOW}Types:${NC}"
    echo "  feat     - New feature"
    echo "  fix      - Bug fix"
    echo "  docs     - Documentation changes"
    echo "  style    - Code style changes (formatting, etc.)"
    echo "  refactor - Code refactoring"
    echo "  perf     - Performance improvements"
    echo "  test     - Adding or updating tests"
    echo "  chore    - Maintenance tasks"
    echo "  build    - Build system changes"
    echo "  ci       - CI/CD changes"
    echo ""
    echo -e "${YELLOW}Scopes (optional):${NC}"
    echo "  agent-manager, orchestrator, reasoning, auth, etc."
    echo ""
    echo -e "${YELLOW}Examples:${NC}"
    echo "  feat(agent-manager): add agent health check endpoint"
    echo "  fix(orchestrator): resolve workflow execution timeout"
    echo "  docs: update README with new installation steps"
    echo "  refactor(reasoning): simplify analysis logic"
    echo ""
    echo -e "${RED}Your commit message:${NC}"
    echo "$COMMIT_MSG"
    echo ""
    exit 1
fi

# Check subject line length
SUBJECT_LINE=$(echo "$COMMIT_MSG" | head -n1)
SUBJECT_LENGTH=${#SUBJECT_LINE}

if [ $SUBJECT_LENGTH -gt 100 ]; then
    echo -e "${RED}Commit subject line too long: $SUBJECT_LENGTH characters${NC}"
    echo -e "${YELLOW}Maximum: 100 characters${NC}"
    echo ""
    echo -e "${RED}Your subject line:${NC}"
    echo "$SUBJECT_LINE"
    echo ""
    exit 1
fi

# Check for imperative mood in subject (basic check)
if echo "$SUBJECT_LINE" | grep -qE "(ed|ing)\s*$"; then
    echo -e "${YELLOW}Warning: Subject should use imperative mood${NC}"
    echo -e "${YELLOW}Use 'add' instead of 'added' or 'adding'${NC}"
    echo ""
    # Don't fail, just warn
fi

# Check for capitalization of subject
if echo "$SUBJECT_LINE" | grep -qE "^[a-z]+\([a-z-]+\): [A-Z]"; then
    echo -e "${YELLOW}Warning: Subject should start with lowercase letter${NC}"
    echo ""
    # Don't fail, just warn
fi

# Check for period at end of subject
if echo "$SUBJECT_LINE" | grep -q "\.$"; then
    echo -e "${YELLOW}Warning: Subject should not end with a period${NC}"
    echo ""
    # Don't fail, just warn
fi

echo -e "${GREEN}✓ Commit message format is valid${NC}"
exit 0
