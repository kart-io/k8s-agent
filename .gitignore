# Proto 管理 (新结构：proto 源文件和生成代码在 pkg/api 同一位置)
# 不忽略 proto 源文件和生成的代码（都提交到仓库）
# !pkg/api/**/*.proto
# !pkg/api/**/*.pb.go

# 可选：如果想要从源码生成，可以忽略生成的文件
# pkg/api/**/*.pb.go
# pkg/api/**/*.pb.gw.go
# pkg/api/docs/swagger/*.json
