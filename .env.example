# Environment Variables Example
# Copy this file to .env and customize for your environment
# DO NOT commit .env file to version control

# ==================================================================================
# Environment
# ==================================================================================

ENVIRONMENT=development
# Options: development, testing, staging, production

# ==================================================================================
# Service Configuration
# ==================================================================================

# Agent Manager
AGENT_MANAGER_HOST=0.0.0.0
AGENT_MANAGER_PORT=8080
AGENT_MANAGER_LOG_LEVEL=debug

# Orchestrator Service
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8081
ORCHESTRATOR_LOG_LEVEL=debug

# Reasoning Service
REASONING_HOST=0.0.0.0
REASONING_PORT=8082
REASONING_LOG_LEVEL=debug

# Auth Service
AUTH_HOST=0.0.0.0
AUTH_PORT=8083
AUTH_LOG_LEVEL=debug

# Gateway Service
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8084
GATEWAY_LOG_LEVEL=debug

# ==================================================================================
# Database Configuration (MySQL)
# ==================================================================================

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=aetherius
DB_PASSWORD=aetherius_pwd
DB_DATABASE=aetherius
DB_CHARSET=utf8mb4
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=10
DB_LOG_MODE=false

# Service-specific databases
AGENT_MANAGER_DB=aetherius
ORCHESTRATOR_DB=aetherius_orchestrator
AUTH_DB=aetherius_auth

# ==================================================================================
# Redis Configuration
# ==================================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=5

# ==================================================================================
# NATS Configuration
# ==================================================================================

NATS_URL=nats://localhost:4222
NATS_CLUSTER_ID=aetherius-cluster
NATS_MAX_RECONNECTS=10
NATS_RECONNECT_WAIT=2s

# ==================================================================================
# Neo4j Configuration (for Reasoning Service)
# ==================================================================================

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=aetherius_pwd
NEO4J_MAX_CONN_POOL_SIZE=50
NEO4J_MAX_TRANSACTION_RETRY=3

# ==================================================================================
# AI Service Configuration (for Reasoning Service)
# ==================================================================================

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-pro

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

# Default AI Provider
AI_PROVIDER=openai
# Options: openai, gemini, deepseek

# ==================================================================================
# Logging Configuration
# ==================================================================================

LOG_LEVEL=debug
# Options: debug, info, warn, error

LOG_FORMAT=text
# Options: json, text

LOG_OUTPUT=stdout
# Options: stdout, stderr, file

LOG_FILE_PATH=/var/log/aetherius
LOG_FILE_MAX_SIZE=100
LOG_FILE_MAX_BACKUPS=10
LOG_FILE_MAX_AGE=30
LOG_FILE_COMPRESS=true

# ==================================================================================
# Metrics and Monitoring
# ==================================================================================

METRICS_ENABLED=true
METRICS_PORT=9091
METRICS_PATH=/metrics

# Prometheus
PROMETHEUS_URL=http://localhost:9090

# Grafana
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=your-grafana-api-key

# ==================================================================================
# Tracing (OpenTelemetry)
# ==================================================================================

TRACING_ENABLED=false
TRACING_ENDPOINT=http://localhost:4317
TRACING_SAMPLE_RATE=0.1

# Jaeger
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# ==================================================================================
# Kubernetes Configuration
# ==================================================================================

KUBECONFIG=~/.kube/config
K8S_NAMESPACE=aetherius
K8S_IN_CLUSTER=false

# ==================================================================================
# Security Configuration
# ==================================================================================

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=168h

# TLS
TLS_ENABLED=false
TLS_CERT_FILE=/etc/aetherius/tls/cert.pem
TLS_KEY_FILE=/etc/aetherius/tls/key.pem
TLS_CA_FILE=/etc/aetherius/tls/ca.pem

# CORS
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_MAX_AGE=86400

# ==================================================================================
# Rate Limiting
# ==================================================================================

RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# ==================================================================================
# Feature Flags
# ==================================================================================

ENABLE_DEBUG=true
ENABLE_PROFILING=true
ENABLE_SWAGGER=true
ENABLE_METRICS=true
ENABLE_TRACING=false
ENABLE_HOT_RELOAD=true

# ==================================================================================
# Docker Configuration
# ==================================================================================

DOCKER_REGISTRY=docker.io
DOCKER_NAMESPACE=kart-io
DOCKER_IMAGE_TAG=latest
DOCKER_BUILDX_PLATFORM=linux/amd64,linux/arm64

# ==================================================================================
# CI/CD Configuration
# ==================================================================================

CI=false
GITHUB_ACTIONS=false
GITHUB_TOKEN=
DOCKER_USERNAME=
DOCKER_PASSWORD=

# ==================================================================================
# Development Tools
# ==================================================================================

# Air (hot reload)
AIR_ENABLED=true

# golangci-lint
LINT_ENABLED=true
LINT_TIMEOUT=5m

# Testing
TEST_TIMEOUT=10m
TEST_PARALLEL=4
TEST_COVERAGE_THRESHOLD=80

# ==================================================================================
# Business Configuration
# ==================================================================================

# Agent Configuration
AGENT_HEARTBEAT_INTERVAL=30s
AGENT_COMMAND_TIMEOUT=300s
AGENT_MAX_CONCURRENT_COMMANDS=10

# Workflow Configuration
WORKFLOW_MAX_PARALLEL_TASKS=5
WORKFLOW_TASK_TIMEOUT=600s
WORKFLOW_MAX_RETRY=3

# Analysis Configuration
ANALYSIS_TIMEOUT=30s
ANALYSIS_MAX_CONTEXT_LENGTH=8000
ANALYSIS_CONFIDENCE_THRESHOLD=0.75

# Notification Configuration
NOTIFICATION_ENABLED=true
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_SMTP_HOST=smtp.gmail.com
NOTIFICATION_EMAIL_SMTP_PORT=587
NOTIFICATION_EMAIL_FROM=noreply@aetherius.io
NOTIFICATION_EMAIL_TO=admin@aetherius.io

# ==================================================================================
# Backup and Recovery
# ==================================================================================

BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/var/backups/aetherius

# ==================================================================================
# Performance Tuning
# ==================================================================================

# Go Runtime
GOMAXPROCS=0
GOGC=100
GOMEMLIMIT=0

# HTTP Server
HTTP_MAX_HEADER_BYTES=1048576
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s

# gRPC Server
GRPC_MAX_RECV_MSG_SIZE=4194304
GRPC_MAX_SEND_MSG_SIZE=4194304
GRPC_KEEPALIVE_TIME=30s
GRPC_KEEPALIVE_TIMEOUT=10s

# ==================================================================================
# Debugging
# ==================================================================================

DEBUG_ENABLED=false
PPROF_ENABLED=false
PPROF_PORT=6060

# Delve (Go debugger)
DELVE_ENABLED=false
DELVE_PORT=2345

# ==================================================================================
# Notes
# ==================================================================================

# 1. Sensitive values (passwords, API keys, tokens) should be:
#    - Stored in a secure secret management system in production
#    - Never committed to version control
#    - Rotated regularly
#
# 2. Environment-specific settings:
#    - Development: Verbose logging, debugging enabled
#    - Testing: Isolated test database, fixtures enabled
#    - Staging: Production-like settings with debug options
#    - Production: Minimal logging, security hardened
#
# 3. Performance considerations:
#    - Adjust connection pools based on load
#    - Monitor resource usage and tune accordingly
#    - Use caching where appropriate
#
# 4. Security checklist:
#    - [ ] Change all default passwords
#    - [ ] Generate strong JWT secret
#    - [ ] Enable TLS in production
#    - [ ] Configure CORS properly
#    - [ ] Enable rate limiting
#    - [ ] Review and restrict API access
#    - [ ] Enable audit logging
#    - [ ] Set up monitoring and alerts
