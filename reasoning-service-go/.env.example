# LLM Provider Configuration
# Choose one or more LLM providers

# ===== Option 1: Ollama (Recommended - Free & Private) =====
# Install: curl -fsSL https://ollama.com/install.sh | sh
# Download model: ollama pull llama3.1
# No API key needed! Ollama runs locally on http://localhost:11434

# ===== Option 2: Cloud LLM Providers (Requires API Key) =====

# OpenAI API Key
# Get your key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Google Gemini API Key
# Get your key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=...
# or
GOOGLE_API_KEY=...

# DeepSeek API Key
# Get your key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=...

# SiliconFlow API Key (国内大模型平台)
# Get your key: https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=...

# Kimi API Key (月之暗面 Moonshot AI - 长文本处理能力强)
# Get your key: https://platform.moonshot.cn/console/api-keys
KIMI_API_KEY=...
# or
MOONSHOT_API_KEY=...

# Custom LLM API Key (自定义 LLM 服务 - 支持任何 OpenAI 兼容的 API)
# For self-hosted or private LLM services
CUSTOM_LLM_API_KEY=...

# ===== Server Configuration (Optional) =====
# These override settings in config.yaml
#SERVER_HOST=0.0.0.0
#SERVER_PORT=8082

# ===== Ollama Custom Configuration (Optional) =====
# If Ollama is running on a different host/port
#OLLAMA_BASE_URL=http://localhost:11434/v1
#OLLAMA_MODEL=llama3.1
